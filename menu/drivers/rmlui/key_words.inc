/* How a key is worded wherever the menu or the builder shows one, by the
 * name RetroArch's config gives it (input/input_key_names.inc). A key with no
 * word here is shown by that name. Every word must draw in every design's
 * font; the pixel fonts have no arrows.
 *
 * RIB_KEY_WORD("name", "Word") */

RIB_KEY_WORD("up", "Up")
RIB_KEY_WORD("down", "Down")
RIB_KEY_WORD("left", "Left")
RIB_KEY_WORD("right", "Right")
RIB_KEY_WORD("enter", "Enter")
RIB_KEY_WORD("escape", "Escape")
RIB_KEY_WORD("space", "Space")
RIB_KEY_WORD("backspace", "Backspace")
RIB_KEY_WORD("tab", "Tab")
RIB_KEY_WORD("del", "Delete")
RIB_KEY_WORD("shift", "Left Shift")
RIB_KEY_WORD("rshift", "Right Shift")
RIB_KEY_WORD("ctrl", "Left Ctrl")
RIB_KEY_WORD("rctrl", "Right Ctrl")
RIB_KEY_WORD("alt", "Left Alt")
RIB_KEY_WORD("ralt", "Right Alt")
RIB_KEY_WORD("num0", "0")
RIB_KEY_WORD("num1", "1")
RIB_KEY_WORD("num2", "2")
RIB_KEY_WORD("num3", "3")
RIB_KEY_WORD("num4", "4")
RIB_KEY_WORD("num5", "5")
RIB_KEY_WORD("num6", "6")
RIB_KEY_WORD("num7", "7")
RIB_KEY_WORD("num8", "8")
RIB_KEY_WORD("num9", "9")

#undef RIB_KEY_WORD
